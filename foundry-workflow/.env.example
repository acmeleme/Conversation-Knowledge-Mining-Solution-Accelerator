# ─────────────────────────────────────────────────────────────
# Azure AI Foundry — Call Center KM Workflow
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Azure AI Foundry Project (NEW Foundry — Agent Workflows) ─
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_GPT_MODEL=gpt-4o

# ── Azure AI Search ──────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-or-query-key>
AZURE_SEARCH_INDEX=km_processed_data
AZURE_SEARCH_SEMANTIC_CONFIG=km-semantic-config

# ── Azure OpenAI (used by deploy_workflow.py / SDK only) ─────
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_KEY=<your-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Legacy Prompt Flow (DEPRECATED — kept for reference) ─────
# PROMPTFLOW_CONNECTION_NAME=azure_openai_connection
